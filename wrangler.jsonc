{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexdev-docs",
  "main": ".open-next/worker.js",
  // Copies the prerendered pages into the assets before every deploy, so they
  // are served without rendering whatever command the deploy runs.
  "build": {
    "command": "npx opennextjs-cloudflare populateCache local"
  },
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "nexdev-docs"
    }
  ],
  "routes": [
    { "pattern": "docs.nervestudios.net", "custom_domain": true },
    { "pattern": "docs.nexdev.site", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
